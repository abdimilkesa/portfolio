# ------------------------------------------------------------------
#  Abdi Milki Portfolio: environment configuration
#
#  Copy this file to `.env` (or run `npm run setup:env`, which also
#  generates a JWT secret) and fill in the values.
#  Never commit your real `.env` file.
# ------------------------------------------------------------------

# --- Server ---------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated frontend origins allowed to call the API (CORS + CSRF checks).
CLIENT_URL=http://localhost:5173
# Public URL of the website, used for the sitemap and robots.txt.
SITE_URL=http://localhost:5173
# Number of reverse proxies in front of the API (use 1 on Render/Railway). Empty = auto.
TRUST_PROXY=
# true = Express also serves the built frontend (single-service deployment).
SERVE_FRONTEND=false

# --- Database -------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/portfolio   (`npm run db:local` starts one)
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# --- Authentication -------------------------------------------------
# At least 32 random characters. `npm run setup:env` generates one for you.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d
# lax = frontend and API on the same site (recommended) | strict | none = cross-site (HTTPS only)
COOKIE_SAME_SITE=lax
# Defaults to true in production. Must be true whenever COOKIE_SAME_SITE=none.
COOKIE_SECURE=

# --- First administrator (read only by `npm run seed:admin`) ---------
ADMIN_NAME=Abdi Milki
ADMIN_EMAIL=admin@example.com
# 12-72 characters. Remove it from the environment after seeding.
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Uploads ----------------------------------------------------------
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10

# --- Contact notifications (optional) ---------------------------------
# When all of these are set, every new contact message is also emailed to you.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_NOTIFY_EMAIL=

# --- Frontend (Vite) --------------------------------------------------
# Only VITE_* variables reach the browser bundle. Never put secrets in them.
# API base URL. Keep `/api` when the frontend is proxied or served by Express.
VITE_API_URL=/api
# Public site URL used for canonical and Open Graph tags at build time.
VITE_SITE_URL=http://localhost:5173
